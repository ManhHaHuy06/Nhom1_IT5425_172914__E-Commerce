DATA_SOURCE_URL=http://host.docker.internal:8000

START_DATE=2016-09-04
END_DATE=2018-10-17

REVIEW_START_DATE=2016-09-04
REVIEW_END_DATE=2018-10-29

CRAWL_UNANSWERED_REVIEWS=true

RUN_TRANSACTIONS=true
RUN_MASTER=true
BOOTSTRAP_MASTER=true

VERIFY_ORDER_COUNT=true
MASTER_PAGE_SIZE=50000

MAX_RETRIES=3
HTTP_TIMEOUT=120
RETRY_BACKOFF=2

LANDING_PREFIX=bronze
RAW_DIR=bronze/olist
STATE_FILE=bronze/_metadata/crawler_state.json
MANIFEST_DIR=bronze/_metadata/manifests

# Shared MinIO from olist-lakehouse (admin / admin123)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=handoff
MINIO_SECURE=false

MINIO_CONNECT_RETRIES=30
MINIO_CONNECT_DELAY=2
