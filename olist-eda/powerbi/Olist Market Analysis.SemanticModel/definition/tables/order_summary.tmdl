	measure 'GMV (Cùng kỳ)' =
			VAR s = EDATE ( [Period Start], -12 )
			VAR e = EDATE ( [Period End], -12 )
			RETURN CALCULATE ( [GMV], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ) )
