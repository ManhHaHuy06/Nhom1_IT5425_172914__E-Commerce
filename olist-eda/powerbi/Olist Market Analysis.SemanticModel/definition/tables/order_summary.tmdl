	measure 'GMV %' = DIVIDE ( [GMV], CALCULATE ( [GMV], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: Tỷ trọng
		lineageTag: 3cb93417-2160-40b1-b9b8-ec7f752fd9df

	measure 'Orders MA7' = AVERAGEX ( DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -7, DAY ), [Valid Orders] + 0 )
		formatString: #,0.0
		displayFolder: Thời gian
		lineageTag: b4ea45dd-6d95-4f22-9fb5-d3a97c1faee0

	measure 'Cumulative GMV % (category)' =
			VAR cur = [GMV]
			VAR tbl = ADDCOLUMNS ( ALLSELECTED ( order_summary[main_category] ), "@g", [GMV] )
			RETURN DIVIDE ( SUMX ( FILTER ( tbl, [@g] >= cur ), [@g] ), SUMX ( tbl, [@g] ) )
		formatString: 0.0%
		displayFolder: Ngành hàng
		lineageTag: 2381eb8a-b400-464c-ad32-5bccd5a3fada

	measure 'Reviewed Orders' = CALCULATE ( COUNTROWS ( order_summary ), NOT ISBLANK ( order_summary[review_score] ) )
		formatString: #,0
		displayFolder: Trải nghiệm
		lineageTag: 31de8a83-1d0f-4a12-81cd-f01c74c2a5d0

	measure 'Avg Review Score' = AVERAGE ( order_summary[review_score] )
		formatString: 0.00
