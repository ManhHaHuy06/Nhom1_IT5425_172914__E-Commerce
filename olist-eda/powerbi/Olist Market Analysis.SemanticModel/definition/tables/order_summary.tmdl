	measure 'GMV % of Row' = DIVIDE ( [Item GMV], CALCULATE ( [Item GMV], REMOVEFILTERS ( item_flow[seller_region], item_flow[seller_region_order] ) ) )
		formatString: 0%
		displayFolder: Cung – cầu
