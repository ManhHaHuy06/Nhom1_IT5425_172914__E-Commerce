	measure 'Report Period Key' = CALCULATE ( MAX ( dim_date[Report Key] ), REMOVEFILTERS ( dim_date ) )
		formatString: 0
		displayFolder: Kỳ báo cáo
		lineageTag: 7aa1d4b5-a84d-4b25-8bfb-484ea22d5a11

	measure 'Period Is Selected' =
			// TRUE khi khoảng chọn trên slicer Khoảng thời gian hẹp hơn toàn bộ lịch (chọn hết = chưa chọn → kỳ mặc định)
			VAR selS = CALCULATE ( MIN ( dim_date[date] ), ALLSELECTED ( dim_date ) )
			VAR selE = CALCULATE ( MAX ( dim_date[date] ), ALLSELECTED ( dim_date ) )
			VAR allS = CALCULATE ( MIN ( dim_date[date] ), REMOVEFILTERS ( dim_date ) )
			VAR allE = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS ( dim_date ) )
			RETURN selS > allS || selE < allE
		displayFolder: Kỳ báo cáo
		lineageTag: a0da0010-5b95-4e83-99c8-6e4a28d4aec3

	measure 'Period Start' =
			VAR k = [Report Period Key]
			RETURN IF ( [Period Is Selected], CALCULATE ( MIN ( dim_date[date] ), ALLSELECTED ( dim_date ) ), DATE ( INT ( k / 100 ), 1, 1 ) )
		formatString: dd/mm/yyyy
		displayFolder: Kỳ báo cáo
		lineageTag: 77a9a2be-9380-4053-bb1b-87b933a4b528

	measure 'Period End' =
			VAR k = [Report Period Key]
			// không vượt quá tháng mới nhất có dữ liệu đầy đủ
			VAR lastFull = EOMONTH ( DATE ( INT ( k / 100 ), MOD ( k, 100 ), 1 ), 0 )
			RETURN IF ( [Period Is Selected], MIN ( CALCULATE ( MAX ( dim_date[date] ), ALLSELECTED ( dim_date ) ), lastFull ), lastFull )
		formatString: dd/mm/yyyy
		displayFolder: Kỳ báo cáo
		lineageTag: 8dad55eb-00bc-4793-bc55-27e528ed8531

	measure 'GMV by Month (Kỳ này)' =
			// so sánh cùng tháng: giữ tháng của trục, bỏ lọc năm
			VAR s = [Period Start]
			VAR e = [Period End]
			RETURN CALCULATE ( [GMV], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ), VALUES ( dim_date[month] ) )
		formatString: \R\$ #,0
		displayFolder: Tổng quan
		lineageTag: 83b79ab8-e95f-49fa-8809-02071b3c4eac

	measure 'GMV by Month (Cùng kỳ)' =
			VAR s = EDATE ( [Period Start], -12 )
			VAR e = EDATE ( [Period End], -12 )
			RETURN CALCULATE ( [GMV], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ), VALUES ( dim_date[month] ) )
		formatString: \R\$ #,0
		displayFolder: Tổng quan
		lineageTag: 5a36bc6a-35ec-4bfa-83b1-bb3ebadde506

	measure 'GMV (Quý này)' =
			// quý chứa ngày cuối kỳ (từ đầu quý, không sớm hơn đầu kỳ, tới cuối kỳ)
			VAR e = [Period End]
			VAR qs = DATE ( YEAR ( e ), INT ( ( MONTH ( e ) - 1 ) / 3 ) * 3 + 1, 1 )
			VAR s = MAX ( qs, [Period Start] )
			RETURN CALCULATE ( [GMV], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ) )
		formatString: \R\$ #,0
		displayFolder: Tổng quan
		lineageTag: 4f2b9c61-7d3e-4a8b-9c15-2e6f0a7b3d41

	measure 'GMV (Quý trước)' =
			// cùng khoảng ngày của 'GMV (Quý này)', lùi 3 tháng
			VAR e = [Period End]
			VAR qs = DATE ( YEAR ( e ), INT ( ( MONTH ( e ) - 1 ) / 3 ) * 3 + 1, 1 )
			VAR s = MAX ( qs, [Period Start] )
			VAR ps = EDATE ( s, -3 )
			VAR pe = IF ( e = EOMONTH ( e, 0 ), EOMONTH ( e, -3 ), EDATE ( e, -3 ) )
			RETURN CALCULATE ( [GMV], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], ps, pe ) )
		formatString: \R\$ #,0
		displayFolder: Tổng quan
		lineageTag: 8a1d3e52-6c4f-4b7a-a2e9-5d0c7f1b9e63

	measure 'GMV QoQ %' = DIVIDE ( [GMV (Quý này)] - [GMV (Quý trước)], [GMV (Quý trước)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Tổng quan
		lineageTag: c3e7a914-2b5d-4f6e-8a1c-9d4b6e2f7a05

	measure 'KPI Color QoQ' = IF ( ISBLANK ( [GMV QoQ %] ), "#6B7280", IF ( [GMV QoQ %] >= 0, "#16A34A", "#DC2626" ) )
		displayFolder: Tổng quan
		lineageTag: 5b9e2d73-1f4a-4c8e-b6d2-7a3f9c1e8b24

	measure 'KPI Color YoY' = IF ( ISBLANK ( [GMV YoY % (Kỳ này)] ), "#6B7280", IF ( [GMV YoY % (Kỳ này)] >= 0, "#16A34A", "#DC2626" ) )
		displayFolder: Tổng quan
		lineageTag: e6a4c8b1-9d2f-4e7b-8c3a-1f5d7b9e2c46

	measure 'Freight Ratio' =
			// tỷ lệ phí ship = freight / giá hàng (đơn hợp lệ)
			DIVIDE (
			    CALCULATE ( SUM ( order_summary[freight_value] ), order_summary[is_valid] = 1 ),
			    CALCULATE ( SUM ( order_summary[product_value] ), order_summary[is_valid] = 1 )
			)
		formatString: 0.0%
		displayFolder: Khu vực
		lineageTag: 4c8098c1-cc6a-4966-97ec-95e0cb0b6b12

	measure 'Freight Ratio (Kỳ này)' =
			VAR s = [Period Start]
			VAR e = [Period End]
			RETURN CALCULATE ( [Freight Ratio], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ) )
		formatString: 0.0%
		displayFolder: Khu vực
		lineageTag: 1f0c3dee-c106-4a74-a9f4-0e64cc4f4b31

	measure 'Late % (Kỳ này)' =
			// tỷ lệ đơn đã giao bị trễ so với ngày hẹn
			VAR s = [Period Start]
			VAR e = [Period End]
			RETURN CALCULATE ( [Late %], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ) )
		formatString: 0.0%
		displayFolder: Khu vực
		lineageTag: 3f677342-9a79-44fa-bcbb-139c7e15b3c8

