	measure 'Repeat Customer %' =
			VAR CustOrders =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( order_summary[customer_key] ), "@orders", CALCULATE ( COUNTROWS ( order_summary ) ) ),
			        order_summary[is_valid] = 1
			    )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( CustOrders, [@orders] >= 2 ) ), COUNTROWS ( CustOrders ) )
		formatString: 0.00%
		displayFolder: Tổng quan
		lineageTag: e96c674d-5b4d-467d-9eb4-cf5a38e66d4e

