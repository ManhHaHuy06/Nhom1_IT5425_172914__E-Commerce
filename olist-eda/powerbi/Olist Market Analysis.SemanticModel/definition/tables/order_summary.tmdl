	measure 'Region Category Share' = DIVIDE ( [Item GMV], CALCULATE ( [Item GMV], REMOVEFILTERS ( item_flow[category], item_flow[is_top12_category] ) ) )
		formatString: 0.0%
		displayFolder: Cung – cầu
		lineageTag: cfb63578-608d-4a0c-918d-33c635f66b5d

	measure LQ =
			// LQ = tỷ trọng ngành trong vùng / tỷ trọng ngành cả nước; > 1: vùng mua nhiều hơn mức chung
			DIVIDE ( [Region Category Share],
			         CALCULATE ( [Region Category Share], REMOVEFILTERS ( order_summary[region], order_summary[region_order] ) ) )
		formatString: 0.00
		displayFolder: Cung – cầu
		lineageTag: b8fc7410-4712-426c-bb01-0a368855aabf

	measure 'Reviewed Rate' = DIVIDE ( COUNT ( order_summary[review_score] ), COUNTROWS ( order_summary ) ) * 100
		displayFolder: Trải nghiệm
		lineageTag: 9f7ab48c-1a30-4cb0-990f-6ff5a0a8ce3e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Review Score %' =
			
			DIVIDE(
			    CALCULATE(
			        [Reviewed Orders],
			        ALLEXCEPT( order_summary, order_summary[score_label], order_summary[score_int] )
			    ),
			    CALCULATE( [Reviewed Orders], ALL( order_summary[score_label], order_summary[score_int] ) )
			) * 100
		displayFolder: Trải nghiệm
		lineageTag: b791b7ef-2d51-46f7-9797-7d6e8c5d5215

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Is Above Avg Negative' =
			
			VAR sys_avg =
			    CALCULATE( [Negative %], ALL( order_summary[main_category] ) )
			RETURN
			    IF( [Negative %] >= sys_avg, 1, 0 )
		formatString: 0
		displayFolder: Trải nghiệm
		lineageTag: 929686f6-1985-4903-9fa5-99d3063f7f19

	measure 'Repeat Purchase Rate %' = ```
			
			    VAR all_valid_orders =
			        FILTER ( order_summary, order_summary[is_valid] = 1 )
			    VAR order_counts =
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                VALUES ( order_summary[customer_key] ),
			                order_summary[is_valid] = 1
			            ),
			            "@n_orders",
			            CALCULATE (
			                COUNTROWS ( order_summary ),
			                ALLEXCEPT ( order_summary, order_summary[customer_key] ),
			                order_summary[is_valid] = 1
			            )
			        )
			    VAR repeat_customers =
			        COUNTROWS ( FILTER ( order_counts, [@n_orders] >= 2 ) )
			    VAR total_customers =
			        COUNTROWS ( CALCULATETABLE ( VALUES ( order_summary[customer_key] ), order_summary[is_valid] = 1 ) )
			    RETURN
			        DIVIDE ( repeat_customers, total_customers )
			```
		displayFolder: Khách hàng
		lineageTag: 9e6716f4-5cd8-416e-8afa-373d3248d6fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

