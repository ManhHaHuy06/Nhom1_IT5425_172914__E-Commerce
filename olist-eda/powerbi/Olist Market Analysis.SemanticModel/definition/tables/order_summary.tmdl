	measure 'GMV YoY % (Kỳ này)' = DIVIDE ( [GMV (Kỳ này)] - [GMV (Cùng kỳ)], [GMV (Cùng kỳ)] )
		formatString: +0%;-0%;0%
		displayFolder: Thị trường
