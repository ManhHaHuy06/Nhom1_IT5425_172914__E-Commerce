	measure 'Delivered Orders' =
			// KEEPFILTERS: giữ filter is_late = 0/1 của measure gọi tới
			CALCULATE ( COUNTROWS ( order_summary ), KEEPFILTERS ( NOT ISBLANK ( order_summary[is_late] ) ) )
