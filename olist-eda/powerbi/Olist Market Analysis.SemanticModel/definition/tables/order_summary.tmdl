		lineageTag: 82029453-3885-4076-b977-393c8098c5b0

	measure 'Satisfied %' = DIVIDE ( CALCULATE ( [Reviewed Orders], order_summary[is_positive] = 1 ), [Reviewed Orders] )
		formatString: 0.0%
