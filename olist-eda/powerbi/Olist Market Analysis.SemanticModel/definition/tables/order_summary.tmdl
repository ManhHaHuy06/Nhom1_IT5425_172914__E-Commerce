		lineageTag: 3b685540-0a4d-4158-aa9e-55ba4668bbec

	measure 'Multi-product Order %' = DIVIDE ( CALCULATE ( [Valid Orders], order_summary[is_multi_product] = 1 ), [Valid Orders] )
