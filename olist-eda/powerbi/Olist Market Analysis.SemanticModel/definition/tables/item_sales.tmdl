	measure 'Product GMV YoY % (cap 600%)' =
			// Ngành tăng > 600% (nền cùng kỳ gần 0) vẽ ở mép trên trục (product §3)
			VAR g = [Product GMV YoY %]
			RETURN IF ( ISBLANK ( g ), BLANK (), MIN ( g, 6 ) )
		formatString: +0%;-0%;0%
		displayFolder: Ngành hàng
		lineageTag: c78c4194-81ed-4c59-ae8f-ee83f354827c

	measure 'Category Share (Kỳ này)' = DIVIDE ( [Product GMV (Kỳ này)], CALCULATE ( [Product GMV (Kỳ này)], REMOVEFILTERS ( dim_category ), REMOVEFILTERS ( item_sales[category] ) ) )
		formatString: 0.0%
		displayFolder: Ngành hàng
		lineageTag: 01029785-c2eb-47cc-9e9a-f796d8e00b46

	measure 'Category Share (Cùng kỳ)' = DIVIDE ( [Product GMV (Cùng kỳ)], CALCULATE ( [Product GMV (Cùng kỳ)], REMOVEFILTERS ( dim_category ), REMOVEFILTERS ( item_sales[category] ) ) )
		formatString: 0.0%
		displayFolder: Ngành hàng
		lineageTag: b925dc18-0a36-42fa-b2fa-77049cb7e110

	measure 'Category Share Change pp' = ( [Category Share (Kỳ này)] - [Category Share (Cùng kỳ)] ) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: Ngành hàng
		lineageTag: 4a4bb633-dcbe-4217-9657-3dd7fb2eb3de

	measure 'Share Change Color' = IF ( [Category Share Change pp] >= 0, "#16A34A", "#DC2626" )
		displayFolder: Ngành hàng
		lineageTag: 72ad99fc-bf55-499c-bdfe-8c167f6c0bde

	measure 'Share Change Top/Bottom 7' =
			// 1 = thuộc 7 ngành được nhiều nhất hoặc 7 ngành mất nhiều tỷ trọng nhất (trong ma trận)
			VAR cur = [Category Share Change pp]
			VAR t =
			    ADDCOLUMNS (
			        FILTER ( ALLSELECTED ( dim_category[category], dim_category[in_matrix] ), dim_category[in_matrix] = "Có" ),
			        "@v", [Category Share Change pp]
			    )
			VAR up = COUNTROWS ( FILTER ( t, [@v] > cur ) ) + 1
			VAR down = COUNTROWS ( FILTER ( t, [@v] < cur ) ) + 1
			RETURN IF ( NOT ISBLANK ( cur ) && ( up <= 7 || down <= 7 ), 1, 0 )
		formatString: 0
		displayFolder: Ngành hàng
		lineageTag: 12e2b7bc-0955-4340-b380-8031e1c6ca5e

	measure 'Top 3 Seller Share' =
			// GMV của 3 người bán lớn nhất / GMV ngành (seller §4)
			DIVIDE ( SUMX ( TOPN ( 3, VALUES ( item_sales[seller_id] ), [Product GMV], DESC ), [Product GMV] ), [Product GMV] )
		formatString: 0%
		displayFolder: Người bán
		lineageTag: 76bd9cd3-a40d-496f-924c-1687b91f5dac

