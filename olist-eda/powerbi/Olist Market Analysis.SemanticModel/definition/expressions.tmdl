	annotation PBI_ResultType = Text

expression GoldTable =
		// Đọc một bảng/view olist_gold qua HTTP interface của ClickHouse (CSVWithNames, NULL = ô trống)
		(view as text) as table =>
		let
		    Raw = Web.Contents(ClickHouseUrl, [
		        Query = [
		            query = "SELECT * FROM olist_gold." & view & " FORMAT CSVWithNames",
		            format_csv_null_representation = ""
		        ],
		        Headers = [#"X-ClickHouse-User" = ClickHouseUser, #"X-ClickHouse-Key" = ClickHousePassword]
		    ]),
		    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers))
		in
		    Nulls
	lineageTag: 5db78dae-fbdb-46a8-8b16-ae86ee427b28

	annotation PBI_ResultType = Function

