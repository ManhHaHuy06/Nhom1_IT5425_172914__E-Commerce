{
  "name": "Olist Market Analysis",
  "dataColors": [
    "#2563EB",
    "#F59E0B",
    "#16A34A",
    "#9CA3AF",
    "#DC2626",
    "#7C3AED",
    "#0EA5E9",
    "#F97316"
  ],
  "good": "#16A34A",
  "neutral": "#FACC15",
  "bad": "#DC2626",
  "maximum": "#2563EB",
  "center": "#93C5FD",
  "minimum": "#EFF6FF",
  "background": "#FFFFFF",
  "foreground": "#111827",
  "tableAccent": "#2563EB",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#111827"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#374151"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#111827"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 8
          }
        ],
        "padding": [
          {
            "top": 6,
            "bottom": 6,
            "left": 8,
            "right": 8
          }
        ]
      }
    }
  }
}