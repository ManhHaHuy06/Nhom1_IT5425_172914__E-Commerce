table dim_state
	lineageTag: 25d1def3-9550-41a4-805f-3460d5e778d0

	measure 'Region Revenue Share' = ```
			
			DIVIDE (
			    [GMV],
			    CALCULATE ( [GMV], REMOVEFILTERS ( dim_state[region], dim_state[region_order] ) )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4c9f1978-b36a-451f-a3b1-7874405d1fe3

	measure 'GMV Cum % (state)' = ```
			
			VAR cur = [GMV]
			VAR tbl = ADDCOLUMNS ( ALLSELECTED ( dim_state ), "@g", [GMV] )
			RETURN
			    IF ( NOT ISBLANK ( cur ),
			         DIVIDE ( SUMX ( FILTER ( tbl, [@g] >= cur ), [@g] ), SUMX ( tbl, [@g] ) ) )
			
			```
		formatString: 0%
		lineageTag: 83bc4afc-0967-4882-8f89-cd9e7f576a8d

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Pareto 80%' = 0.8
		lineageTag: 9140375d-235f-476b-b1e5-9e646de91e10

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cầu (khách)' = ```
			
			SUM ( item_flow[item_gmv] )
			
			```
		lineageTag: 91552cd3-6ea1-44c2-99a7-11b10aa78839

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cung (người bán)' = ```
			
			CALCULATE (
			    SUM ( item_flow[item_gmv] ),
			    REMOVEFILTERS ( dim_state ),
			    TREATAS ( VALUES ( dim_state[state] ), item_flow[seller_state] )
			)
			
			```
		lineageTag: 6b9bd468-af4f-4178-be34-1b49d382713f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Map Metric Selected' = SELECTEDVALUE ( 'Map Metric'[Chỉ số], "GMV" )
		displayFolder: Bản đồ
		lineageTag: f67beb39-623a-4624-bf35-86eabff7fb10

	measure 'Map Level Selected' = SELECTEDVALUE ( 'Map Level'[Cấp độ], "Bang" )
		displayFolder: Bản đồ
		lineageTag: f9c281e9-f80e-4c9e-bb88-7959e3708642

	measure 'Map GMV' = ```
			// GMV ở cấp đã chọn (bang, hoặc cả vùng kinh tế chứa bang)
			VAR r = SELECTEDVALUE ( dim_state[region] )
			RETURN
			    IF ( [Map Level Selected] = "Vùng",
			         IF ( NOT ISBLANK ( r ), CALCULATE ( [GMV], REMOVEFILTERS ( dim_state ), dim_state[region] = r ) ),
			         [GMV] )
			
			```
		formatString: \R\$ #,0
		displayFolder: Bản đồ
		lineageTag: 24b086b9-0f15-4b5f-abbc-31be582f16ad

	measure 'Map Orders' = ```
			
			VAR r = SELECTEDVALUE ( dim_state[region] )
			RETURN
			    IF ( [Map Level Selected] = "Vùng",
			         IF ( NOT ISBLANK ( r ), CALCULATE ( [Valid Orders], REMOVEFILTERS ( dim_state ), dim_state[region] = r ) ),
			         [Valid Orders] )
			
			```
		formatString: #,0
		displayFolder: Bản đồ
		lineageTag: 540f0a90-da91-44ef-a0df-ca06c0573e6a

	measure 'Map QoQ' = ```
			// GMV quý chứa ngày cuối kỳ so với quý trước (cùng logic KPI QoQ trang Tổng quan)
			VAR r = SELECTEDVALUE ( dim_state[region] )
			RETURN
			    IF ( [Map Level Selected] = "Vùng",
			         IF ( NOT ISBLANK ( r ), CALCULATE ( [GMV QoQ %], REMOVEFILTERS ( dim_state ), dim_state[region] = r ) ),
			         [GMV QoQ %] )
			
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Bản đồ
		lineageTag: cb72faa1-8aa6-4118-84e5-6db143bade19

	measure 'Map GMV Share' =
			// tỷ trọng GMV của bang/vùng trên toàn quốc (trong bộ lọc hiện tại)
			DIVIDE ( [Map GMV], CALCULATE ( [GMV], REMOVEFILTERS ( dim_state ) ) )
		formatString: 0.0%
		displayFolder: Bản đồ
		lineageTag: cdc256bc-044d-455a-bb81-cc7aae55fb56

	measure 'Map Value' =
			SWITCH ( [Map Metric Selected],
			    "Số đơn", [Map Orders],
			    "Số khách hàng", [Map Customers],
			    "Số người bán", [Map Sellers],
			    "Tăng trưởng QoQ", [Map QoQ],
			    [Map GMV] )
		displayFolder: Bản đồ
		lineageTag: 71dbf5af-6e90-45be-a353-52e17ee3bc00

	measure 'Map Score' =
			// Điểm tô màu cho Shape map (gradient 3 màu cố định: -1 đỏ, 0 xám, +1 xanh đậm)
			// GMV / Số đơn: 5 lớp 0.2..1 theo % so với bang (vùng) lớn nhất; QoQ: tăng trưởng / 30%, giới hạn [-1, 1]
			VAR v = [Map Value]
			RETURN
			    IF ( NOT ISBLANK ( v ),
			        IF ( [Map Metric Selected] = "Tăng trưởng QoQ",
			            MAX ( -1, MIN ( 1, v / 0.3 ) ),
			            VAR mx = MAXX ( ALLSELECTED ( dim_state[Map Location] ), [Map Value] )
			            VAR r = DIVIDE ( v, mx )
			            RETURN
			                SWITCH ( TRUE (),
			                    r >= 0.5, 1,
			                    r >= 0.2, 0.8,
			                    r >= 0.08, 0.6,
			                    r >= 0.03, 0.4,
			                    0.2 ) ) )
		formatString: 0.00
		displayFolder: Bản đồ
		lineageTag: da251e6b-1c22-4570-a34f-97c25a83e390

	measure 'Map Area' =
			VAR st = SELECTEDVALUE ( dim_state[state_name] )
			VAR cd = SELECTEDVALUE ( dim_state[state] )
			VAR rg = SELECTEDVALUE ( dim_state[region] )
			RETURN
			    IF ( [Map Level Selected] = "Vùng",
			         "Vùng " & rg & " (bang " & st & ")",
			         st & " (" & cd & ") – vùng " & rg )
		displayFolder: Bản đồ
		lineageTag: 7a9c8589-094f-47ea-8d32-a7b2c8198b91

	measure 'Map Title' =
			VAR m = [Map Metric Selected]
			VAR lv = IF ( [Map Level Selected] = "Vùng", "5 vùng kinh tế", "bang" )
			RETURN
			    SWITCH ( m,
			        "Số đơn", "Số đơn hàng theo " & lv,
			        "Số khách hàng", "Số khách hàng theo " & lv,
			        "Số người bán", "Số người bán (đặt tại) theo " & lv,
			        "Tăng trưởng QoQ", "Tăng trưởng GMV QoQ theo " & lv,
			        "GMV theo " & lv )
		displayFolder: Bản đồ
		lineageTag: 7be8eb26-f71a-4718-b0f3-c9df7e327d5b

	measure 'Sellers in State' =
			// số người bán (có đơn hợp lệ trong bộ lọc) ĐẶT TẠI bang/vùng đang xét — theo bang của người bán, không phải bang khách
			CALCULATE (
			    DISTINCTCOUNT ( geo_seller[seller_id] ),
			    order_summary[is_valid] = 1,
			    REMOVEFILTERS ( dim_state ),
			    TREATAS ( VALUES ( dim_state[state] ), geo_seller[seller_state] )
			)
		formatString: #,0
		displayFolder: Bản đồ
		lineageTag: 21ff6d2a-ee96-4aab-b305-b0532627a166

	measure 'Map Customers' = ```
			// số khách hàng (customer_key) có đơn hợp lệ, theo bang của khách
			VAR r = SELECTEDVALUE ( dim_state[region] )
			RETURN
			    IF ( [Map Level Selected] = "Vùng",
			         IF ( NOT ISBLANK ( r ), CALCULATE ( [Customers], REMOVEFILTERS ( dim_state ), dim_state[region] = r ) ),
			         [Customers] )
			
			```
		formatString: #,0
		displayFolder: Bản đồ
		lineageTag: 0ad2e0ab-870b-48fd-8b6d-37a1b7adc203

	measure 'Map Sellers' = ```
			
			VAR r = SELECTEDVALUE ( dim_state[region] )
			RETURN
			    IF ( [Map Level Selected] = "Vùng",
			         IF ( NOT ISBLANK ( r ), CALCULATE ( [Sellers in State], REMOVEFILTERS ( dim_state ), dim_state[region] = r ) ),
			         [Sellers in State] )
			
			```
		formatString: #,0
		displayFolder: Bản đồ
		lineageTag: ef527295-f088-4259-9bb3-86d9933c91df

	measure 'Seller Density (Kỳ này)' = ```
			// mật độ người bán = số người bán đặt tại vùng i / số khách hàng tại vùng i (đơn hợp lệ trong kỳ), hiển thị trên 1.000 khách
			// vùng i lấy theo bang khách đang lọc (slicer order_summary hoặc dim_state), rồi chuyển sang bang người bán
			VAR s = [Period Start]
			VAR e = [Period End]
			VAR states = CALCULATETABLE ( VALUES ( order_summary[state] ), REMOVEFILTERS ( dim_date ) )
			VAR sellers =
			    CALCULATE (
			        DISTINCTCOUNT ( geo_seller[seller_id] ),
			        order_summary[is_valid] = 1,
			        REMOVEFILTERS ( dim_state ),
			        REMOVEFILTERS ( order_summary[state], order_summary[region], order_summary[region_order] ),
			        TREATAS ( states, geo_seller[seller_state] ),
			        REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e )
			    )
			VAR customers = [Customers (Kỳ này)]
			RETURN DIVIDE ( sellers, customers ) * 1000
			
			```
		formatString: #,0.0
		displayFolder: KPI Khu vực
		lineageTag: 2c67a81d-5124-474d-848e-5093370060ef

	measure 'Supply-Demand Gap (Kỳ này)' =
			// (GMV người bán đặt tại vùng i bán ra - GMV khách vùng i mua vào) / GMV khách vùng i mua; âm = vùng thiếu cung, phải nhập hàng từ vùng khác
			VAR s = [Period Start]
			VAR e = [Period End]
			VAR states = CALCULATETABLE ( VALUES ( order_summary[state] ), REMOVEFILTERS ( dim_date ) )
			VAR cau = CALCULATE ( SUM ( item_flow[item_gmv] ), REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ) )
			VAR cung =
			    CALCULATE (
			        SUM ( item_flow[item_gmv] ),
			        REMOVEFILTERS ( dim_state ),
			        REMOVEFILTERS ( order_summary[state], order_summary[region], order_summary[region_order] ),
			        TREATAS ( states, item_flow[seller_state] ),
			        REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e )
			    )
			RETURN DIVIDE ( cung - cau, cau )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPI Khu vực
		lineageTag: dd738cf7-9599-4e0f-a3e2-e958060d4821

	measure 'Inter-region Delivery %' =
			// tỷ lệ dòng hàng (đơn hợp lệ) mà người bán ở vùng kinh tế khác vùng của khách
			DIVIDE (
			    COUNTROWS ( FILTER ( item_flow, item_flow[seller_region] <> RELATED ( order_summary[region] ) ) ),
			    COUNTROWS ( item_flow )
			)
		formatString: 0.0%
		displayFolder: KPI Khu vực
		lineageTag: 0b44c877-754b-40e0-b2d2-84b141867583

	measure 'Inter-region Delivery % (Kỳ này)' =
			VAR s = [Period Start]
			VAR e = [Period End]
			RETURN CALCULATE ( [Inter-region Delivery %], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e ) )
		formatString: 0.0%
		displayFolder: KPI Khu vực
		lineageTag: 83bed174-dcf1-4121-ad66-ff6074a6fdc3

	measure 'Avg Delivery Days (Kỳ này)' =
			// số ngày giao thực tế trung bình (mua -> nhận), đơn hợp lệ đã giao
			VAR s = [Period Start]
			VAR e = [Period End]
			RETURN CALCULATE (
			    AVERAGE ( order_summary[delivery_days] ),
			    order_summary[is_valid] = 1, NOT ISBLANK ( order_summary[is_late] ),
			    REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e )
			)
		formatString: 0.0
		displayFolder: KPI Khu vực
		lineageTag: 23b3266d-9a8c-432b-b890-51b8405e74e3

	measure 'Avg Promised Days (Kỳ này)' =
			// số ngày cam kết (SLA) trung bình (mua -> ngày hẹn giao), đơn hợp lệ đã giao
			VAR s = [Period Start]
			VAR e = [Period End]
			RETURN CALCULATE (
			    AVERAGE ( order_summary[estimated_delivery_days] ),
			    order_summary[is_valid] = 1, NOT ISBLANK ( order_summary[is_late] ),
			    REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[date], s, e )
			)
		formatString: 0.0
		displayFolder: KPI Khu vực
		lineageTag: 97ee9d7b-86bb-4259-a96c-cdb0213c6729

	measure 'SLA Display (Kỳ này)' =
			// thẻ SLA: thời gian giao thực tế TB / thời gian cam kết TB
			VAR a = [Avg Delivery Days (Kỳ này)]
			VAR p = [Avg Promised Days (Kỳ này)]
			RETURN IF ( NOT ISBLANK ( a ), FORMAT ( a, "0.0" ) & " / " & FORMAT ( p, "0.0" ) & " ngày" )
		displayFolder: KPI Khu vực
		lineageTag: ddfe2795-36ab-48ab-a2b8-306391b851e4

	measure 'Region Category Gap' =
			// ma trận lệch pha cung – cầu: dòng = vùng của khách, cột = ngành hàng (item_flow[category])
			// (GMV người bán ĐẶT TẠI vùng bán ra trong ngành - GMV khách vùng đó mua trong ngành) / GMV khách vùng đó mua
			// âm = thiếu nguồn cung nội vùng (phải nhập từ vùng khác), dương = dư cung (xuất sang vùng khác)
			// bỏ qua slicer Vùng/Bang của khách để luôn so sánh đủ 5 vùng; vùng lấy theo dòng ma trận (dim_state[region])
			VAR regions = VALUES ( dim_state[region] )
			VAR cau =
			    CALCULATE (
			        SUM ( item_flow[item_gmv] ),
			        REMOVEFILTERS ( dim_state ),
			        REMOVEFILTERS ( order_summary[state], order_summary[region], order_summary[region_order] ),
			        TREATAS ( regions, order_summary[region] )
			    )
			VAR cung =
			    CALCULATE (
			        SUM ( item_flow[item_gmv] ),
			        REMOVEFILTERS ( dim_state ),
			        REMOVEFILTERS ( order_summary[state], order_summary[region], order_summary[region_order] ),
			        TREATAS ( regions, item_flow[seller_region] )
			    )
			RETURN IF ( NOT ISBLANK ( cau ), DIVIDE ( cung - cau, cau ) )
		formatString: +0%;-0%;0%
		displayFolder: KPI Khu vực
		lineageTag: e1328ab9-2397-4088-8de7-58b28d267589

