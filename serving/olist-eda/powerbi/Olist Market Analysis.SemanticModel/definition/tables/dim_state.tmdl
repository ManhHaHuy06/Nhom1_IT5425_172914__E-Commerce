	column state_name =
			SWITCH ( dim_state[state],
			    "AC", "Acre",
			    "AL", "Alagoas",
			    "AP", "Amapá",
			    "AM", "Amazonas",
			    "BA", "Bahia",
			    "CE", "Ceará",
			    "DF", "Distrito Federal",
			    "ES", "Espírito Santo",
			    "GO", "Goiás",
			    "MA", "Maranhão",
			    "MT", "Mato Grosso",
			    "MS", "Mato Grosso do Sul",
			    "MG", "Minas Gerais",
			    "PA", "Pará",
			    "PB", "Paraíba",
			    "PR", "Paraná",
			    "PE", "Pernambuco",
			    "PI", "Piauí",
			    "RJ", "Rio de Janeiro",
			    "RN", "Rio Grande do Norte",
			    "RS", "Rio Grande do Sul",
			    "RO", "Rondônia",
			    "RR", "Roraima",
			    "SC", "Santa Catarina",
			    "SP", "São Paulo",
			    "SE", "Sergipe",
			    "TO", "Tocantins",
			    dim_state[state] )
		dataType: string
		lineageTag: 12ded250-8cdf-4492-b001-4188f481752f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Map Location' =
			// key của Shape map 'Brazil: states' = tên bang không dấu
			VAR n = dim_state[state_name] RETURN SWITCH ( n,
			    "Amapá", "Amapa",
			    "Ceará", "Ceara",
			    "Espírito Santo", "Espirito Santo",
			    "Goiás", "Goias",
			    "Maranhão", "Maranhao",
			    "Pará", "Para",
			    "Paraíba", "Paraiba",
			    "Paraná", "Parana",
			    "Piauí", "Piaui",
			    "Rondônia", "Rondonia",
			    "São Paulo", "Sao Paulo",
			    n )
		dataType: string
		lineageTag: 7d1331ad-8824-43fb-a070-ec3fbcdaf1c5
		dataCategory: StateOrProvince
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_state = m
		mode: import
		source =
				let
					Source = GoldTable("dim_state"),
					Typed = Table.TransformColumnTypes(Source, {{"state", type text}, {"region", type text}, {"region_order", Int64.Type}, {"population_2018", Int64.Type}, {"in_matrix", type text}, {"quadrant", type text}, {"quadrant_order", Int64.Type}}, "en-US")
				in
					Typed

