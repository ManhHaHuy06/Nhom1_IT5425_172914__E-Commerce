	column n_categories = CALCULATE ( DISTINCTCOUNTNOBLANK ( item_sales[category] ) ) + 0
		dataType: int64
		formatString: 0
		lineageTag: b9b3f618-4994-48c9-857a-3832eda54a71
		summarizeBy: none

	column category_band_order = SWITCH ( TRUE (), dim_seller[n_categories] <= 1, 1, dim_seller[n_categories] = 2, 2, dim_seller[n_categories] <= 4, 3, 4 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fc42f6a4-802c-400a-9e23-076f46ca79bf
		summarizeBy: none

	column category_band = SWITCH ( dim_seller[category_band_order], 1, "1 ngành", 2, "2 ngành", 3, "3–4 ngành", "≥ 5 ngành" )
		dataType: string
		lineageTag: 0e5cb997-fa7a-4bf8-9dff-1cf0d3d585aa
