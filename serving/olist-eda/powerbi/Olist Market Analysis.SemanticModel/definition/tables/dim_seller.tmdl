table dim_seller
	lineageTag: 9999fc69-656c-426e-b818-1dbc991d6794

	measure 'Seller GMV Median' = MEDIAN ( dim_seller[gmv] )
		formatString: #,0
		displayFolder: Người bán
		lineageTag: d4fa98fc-8df3-4cf5-a4ed-3b997e34251a

	measure 'Seller Share in Category Band' =
			DIVIDE ( COUNTROWS ( dim_seller ),
			    CALCULATE ( COUNTROWS ( dim_seller ), REMOVEFILTERS ( dim_seller[category_band], dim_seller[category_band_order] ) ) )
		formatString: 0%
		displayFolder: Người bán
		lineageTag: 4e41d4cc-0c55-4c64-b956-99e58cbef6fb

	measure 'GMV Share in Category Band' =
			DIVIDE ( SUM ( dim_seller[gmv] ),
			    CALCULATE ( SUM ( dim_seller[gmv] ), REMOVEFILTERS ( dim_seller[category_band], dim_seller[category_band_order] ) ) )
		formatString: 0%
		displayFolder: Người bán
		lineageTag: e6857b5e-7ad1-430e-abc9-b93398ffa446

	measure 'Category Band Label' =
			FORMAT ( [Seller Share in Category Band], "0%" ) & " / "
			    & FORMAT ( [GMV Share in Category Band], "0%" )
		displayFolder: Người bán
		lineageTag: 8a2cff74-52e8-426d-b1d5-df74475e7bb3

