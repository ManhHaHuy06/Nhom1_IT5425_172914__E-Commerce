# Aiven MySQL Server Configuration
MYSQL_HOST=changeme
MYSQL_PORT=changeme
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=Brazilian E-Commerce
MYSQL_URL=changeme
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver


# Data Lake / MinIO (local docker)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=olistadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=olist-lake
# Read-only MinIO user for olist-lakehouse (put the same pair in olist-lakehouse/infrastructure/.env as SOURCE_S3_*)
LAKE_READER_ACCESS_KEY=lakehouse_reader
LAKE_READER_SECRET_KEY=changeme

# OLTP MySQL (local docker, simulated website DB)
OLTP_ROOT_PASSWORD=changeme
OLTP_DATABASE=shop
OLTP_HOST=localhost
OLTP_PORT=3307
OLTP_SIM_USER=sim_rw
OLTP_SIM_PASSWORD=changeme
OLTP_ETL_USER=etl_ro
OLTP_ETL_PASSWORD=changeme

# Airflow (local docker)
AIRFLOW_FERNET_KEY=changeme
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_PG_PASSWORD=changeme

# Lakehouse ETL orchestration (Airflow -> Docker Engine API -> Spark & ClickHouse containers)
LAKEHOUSE_SPARK_CONTAINER=olist-spark-master
LAKEHOUSE_CLICKHOUSE_CONTAINER=olist-clickhouse
LAKEHOUSE_SOURCE_URI=s3a://olist-lake/landing
# Linux hosts where /var/run/docker.sock is owned by the docker group: set DOCKER_GID=$(stat -c %g /var/run/docker.sock)
DOCKER_GID=0
