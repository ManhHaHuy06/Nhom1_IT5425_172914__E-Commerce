# Mẫu cấu hình docker-compose của lakehouse. Chép thành .env (run_lakehouse.bat tự chép nếu chưa có).
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD là nguồn duy nhất: Spark, Trino, Iceberg REST và ClickHouse đọc từ biến môi trường.
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=iceberg123
EXTERNAL_POSTGRES_PORT=5433

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
# Đổi cổng host nếu bị trùng (máy dev hiện dùng 9100/9101 vì 9000-9002 bận)
EXTERNAL_MINIO_API_PORT=9100
EXTERNAL_MINIO_CONSOLE_PORT=9101

EXTERNAL_ICEBERG_REST_PORT=8181
EXTERNAL_SPARK_UI_PORT=8084
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g
EXTERNAL_TRINO_PORT=8085

EXTERNAL_CLICKHOUSE_HTTP_PORT=8123
EXTERNAL_CLICKHOUSE_NATIVE_PORT=9200
CLICKHOUSE_PASSWORD=admin123

# Nguồn Landing mặc định: MinIO của hosting_server (Parquet do Airflow ghi vào bucket olist-lake/landing).
# Spark đi qua cổng host 9000 của hosting_server. Nên dùng user chỉ đọc do hosting_server/infra/minio-init.sh tạo
# (LAKE_READER_ACCESS_KEY / LAKE_READER_SECRET_KEY trong hosting_server/.env).
SOURCE_S3_ENDPOINT=http://host.docker.internal:9000
SOURCE_S3_BUCKET=olist-lake
SOURCE_S3_ACCESS_KEY=lakehouse_reader
SOURCE_S3_SECRET_KEY=changeme
